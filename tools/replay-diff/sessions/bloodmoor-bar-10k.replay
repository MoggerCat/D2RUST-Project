check 1
# replay-diff session (specs/tools/replay-diff.md): 10,000 frames of fighting
# in the Blood Moor, CmbBar (level 3 barbarian, short sword), seed 1234:
# warped to the Blood Moor (level 2) before frame 4; game and player unit
# seeds fixed before frame 30 (as combat-melee-fallen); a fallen party
# (monstats 19) spawned next to the player every 1,000 frames. The input
# attacks the nearest fallen (clickunit 1 19, four times 22 frames apart),
# loots (clickunit 4 *) and walks on (run on). 1.14d plays the input; d2rs
# gets the C->S messages 1.14d sent, frame by frame. Input generated once by
# a fixed LCG (seed 1371).
name bloodmoor-bar-10k
save CmbBar --class bar --expansion --level 3 --item ssd/body=4
seed 1234
ticks 10000
seconds 7000
at 4 poke warp 2
at 30 poke seed-game 0x00001234 666
at 30 poke seed-unit @player 0x00000055 666
at 30 poke spawn 19 @x+3 @y normal
at 1000 poke spawn 19 @x+3 @y normal
at 2000 poke spawn 19 @x+3 @y normal
at 3000 poke spawn 19 @x+3 @y normal
at 4000 poke spawn 19 @x+3 @y normal
at 5000 poke spawn 19 @x+3 @y normal
at 6000 poke spawn 19 @x+3 @y normal
at 7000 poke spawn 19 @x+3 @y normal
at 8000 poke spawn 19 @x+3 @y normal
at 9000 poke spawn 19 @x+3 @y normal
