# Act IV objectives for tools/playthrough/playthrough.py (spec:
# specs/tools/playthrough.md). Crude, as act1.play: pokes (warp, pos,
# stat, missile) jump between milestones; each milestone is its own
# state-dump run. A boss kill is a Fire Bolt `missile` poke at the boss
# (moved next to the player, life set to 1): the headless right click
# walks instead of casting (spec Open question 2). A boss outside the
# start's active rooms is found by a sweep (`find`) first.
# Quests: specs/world/quests-act4.md (slots 25 The Fallen Angel,
# 26 Terror's End, 27 Hell's Forge, 28 Act IV completed (expansion);
# quests.md §1.3).
# Ids from the 1.14d tables (levels.txt rows, monstats rows, objects.txt
# rows): Pandemonium Fortress 103, Outer Steppes 104, Plains of Despair
# 105, City of the Damned 106, River of Flame 107, Chaos Sanctum 108,
# Harrogath 109; Diablo 243, Deckard Cain (Act IV) 246, Izual 256,
# Halbu 257, Tyrael (Act IV) 367, Jamella 405, Hephasto 409; Hellforge
# 376, Chaos Sanctum seals 392-396, waypoint objects 119,145,156,157,
# 237,238,288,323,324,398,402,429,494,496,511,539.
playthrough 1
act 4

# Act IV town (town byte act 3), Acts I-III done (acts=3: slots 7, 15, 23 bit 0).
save sor --name PtSorD --class sor --expansion --level 50 --skill 8=20 --right-skill 44 --stat 8=128000 --stat 9=128000 --waypoints all --quests acts=3 --act 3 --difficulty normal

milestone town-start
  use sor
  deadline 40
  note NPCs outside the start's active rooms are left out (as act1 Akara)
  need player lv == 103
  need player act == 3
  need unit ut 1 cl 246,257,367,405 count >= 2

milestone town-wp
  use sor
  deadline 1000
  sweep 20 2 300 30
  need ever player lv == 103
  need unit ut 2 cl 119,145,156,157,237,238,288,323,324,398,402,429,494,496,511,539 lv 103 seen

milestone outer-steppes
  use sor
  deadline 80
  poke 5 warp 104
  need player lv == 104
  need unit ut 1 lv 104 count >= 3

milestone izual-present
  use sor
  deadline 1000
  poke 5 warp 105
  sweep 20 2 400 40
  need ever player lv == 105
  need unit ut 1 cl 256 lv 105 seen

milestone izual-killed
  use sor
  deadline 1000
  poke 5 warp 105
  sweep 20 2 400 40
  find ut 1 cl 256
  poke +2 pos @1:256 @x+3 @y
  note q-prov-data: the Fire Bolt poke vanishes in the frame it is created in the Plains of Despair (open)
  poke +2 stat @1:256 6 0 256
  poke +10 missile 58 @x @y @x+3 @y skill 36 1
  need ever unit ut 1 cl 256 killed

milestone city-of-the-damned
  use sor
  deadline 80
  poke 5 warp 106
  need player lv == 106
  need unit ut 1 lv 106 count >= 3

milestone hellforge
  use sor
  deadline 1000
  poke 5 warp 107
  sweep 20 2 800 80
  need ever player lv == 107
  need unit ut 2 cl 376 lv 107 seen

milestone hephasto-present
  use sor
  deadline 1000
  poke 5 warp 107
  sweep 20 2 800 80
  need ever player lv == 107
  need unit ut 1 cl 409 lv 107 seen

milestone chaos-sanctum-seals
  use sor
  deadline 1000
  poke 5 warp 108
  sweep 20 2 400 40
  need ever player lv == 108
  need unit ut 2 cl 392,393,394,395,396 lv 108 seen

# Diablo (q-fix-act4-play): the real flow, no spawn poke. Seed 5 (the level seed
# picks the De Seis arm file: seeds 1-4, 6-9, 11 give WingN1, whose boss spot
# (-39,+33) lies 6 sub-tiles outside the DS1 and the free-spot search ends on
# a spot with no room, so the seal stays shut -- see docs/handoff/q-fix-act4-play.md;
# seed 5 gives WingN2). The player is made tough (stat 7/6) so Sanctuary
# monsters do not kill her mid-walk. Each seal is reached with `goto preset
# 108 2:<seal>` and operated with msg 0x13 (InteractWithEntity, type 2, GUID);
# the GUIDs are the goto results for seed 5 (a `goto` result cannot be named
# by @pI yet). Bosses (Infector, De Seis, Vizier) are pulled next to the
# player, set to 1 hp and shot with Fire Bolt; three kills with five seals
# open start Diablo's timer, which needs the start point (object 255) loaded,
# hence the last goto.
milestone diablo-present
  use sor
  seed 5
  deadline 2900
  poke 5 warp 108
  poke 6 stat @player 7 0 7680000
  poke 7 stat @player 6 0 7680000
  goto 20 preset 108 2:392
  poke 400 msg 0x13 2 122
  poke 450 pos 1/146 @x+3 @y
  poke 451 stat 1/146 6 0 256
  poke 455 missile 58 @x @y @x+3 @y skill 36 1
  goto 500 preset 108 2:393
  poke 900 msg 0x13 2 127
  goto 1000 preset 108 2:394
  poke 1400 msg 0x13 2 150
  poke 1450 pos 1/147 @x+3 @y
  poke 1451 stat 1/147 6 0 256
  poke 1455 missile 58 @x @y @x+3 @y skill 36 1
  goto 1500 preset 108 2:395
  poke 1900 msg 0x13 2 202
  goto 2000 preset 108 2:396
  poke 2400 msg 0x13 2 195
  poke 2450 pos 1/148 @x+3 @y
  poke 2451 stat 1/148 6 0 256
  poke 2455 missile 58 @x @y @x+3 @y skill 36 1
  goto 2600 preset 108 2:255
  need player lv == 108
  need ever unit ut 1 cl 243 present

milestone diablo-killed
  use sor
  seed 5
  deadline 3100
  poke 5 warp 108
  poke 6 stat @player 7 0 7680000
  poke 7 stat @player 6 0 7680000
  goto 20 preset 108 2:392
  poke 400 msg 0x13 2 122
  poke 450 pos 1/146 @x+3 @y
  poke 451 stat 1/146 6 0 256
  poke 455 missile 58 @x @y @x+3 @y skill 36 1
  goto 500 preset 108 2:393
  poke 900 msg 0x13 2 127
  goto 1000 preset 108 2:394
  poke 1400 msg 0x13 2 150
  poke 1450 pos 1/147 @x+3 @y
  poke 1451 stat 1/147 6 0 256
  poke 1455 missile 58 @x @y @x+3 @y skill 36 1
  goto 1500 preset 108 2:395
  poke 1900 msg 0x13 2 202
  goto 2000 preset 108 2:396
  poke 2400 msg 0x13 2 195
  poke 2450 pos 1/148 @x+3 @y
  poke 2451 stat 1/148 6 0 256
  poke 2455 missile 58 @x @y @x+3 @y skill 36 1
  goto 2600 preset 108 2:255
  poke 2900 pos 1/149 @x+3 @y
  poke 2901 stat 1/149 6 0 256
  poke 2905 missile 58 @x @y @x+3 @y skill 36 1
  need ever unit ut 1 cl 243 killed

milestone to-act5
  use sor
  deadline 100
  poke 5 warp 109
  need player lv == 109
  need player act == 4
