# Walk in the Act I town: three walks relative to the start position.
# Spec: specs/tools/scenario.md; movement: specs/sim/pathing.md.
scenario 1
name walk-town
game 1.14d
seed 0x00001234
map 644409375        # the test character's map ID (specs/sim/rng.md §5.4)
difficulty normal
expansion yes
end 120

char class 1          # sorceress
char area 0 1         # Rogue Encampment
char at default

record s2c rng units stats
snapshot every 20

at 2 msg Walk x=@x+8 y=@y
at 40 msg Walk x=@x y=@y+6
at 80 msg Walk x=@x-8 y=@y-6
