skill 6 4   # static (skill 42)
skill 7 1   # tk (skill 43)
skill 8 8   # nova (skill 44)
skill 9 6   # blast (skill 45)
skill 1 1   # warmth (skill 37)
skill 18 1   # tele (skill 54)
skill 19 1   # gs (skill 55)
right-skill 45
left-skill 36
gold 150000
